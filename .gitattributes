# 默认：文本文件统一 LF，二进制不动
* text=auto eol=lf

# 二进制类型（避免 git 尝试文本合并、避免行尾转换损坏）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.tar.gz binary
*.bundle binary
*.xlsx  binary
*.xls   binary
*.pkl   binary
*.feather binary
*.parquet binary

# shell 脚本必须是 LF，否则在 Linux 上直接 "bad interpreter"
*.sh    text eol=lf

# Windows 脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 文档和 notebook 保持 LF
*.md    text eol=lf
*.ipynb text eol=lf
*.py    text eol=lf
